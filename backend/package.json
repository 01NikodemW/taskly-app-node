{
  "name": "taskly-node-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "vitest": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "supertest": "^7.1.4",
    "typescript": "^5.8.3",
    "tsx": "^4.20.0",
    "@types/node": "^22.20.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/supertest": "^6.0.0"
  }
}
